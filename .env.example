# ---------------------------------------------------------------------------
# PICKsel env conventions
#
#   PICKSEL_ENV            local | staging | production   (never inferred)
#   NEXT_PUBLIC_* / EXPO_PUBLIC_*  -> shipped to the client. Safe values only.
#   everything else        -> server-only. Never import into apps/field.
#
# Files (all gitignored except this one):
#   .env                   local defaults shared by turbo tasks
#   apps/portal/.env.local Next.js local dev
#   apps/field/.env        Expo local dev
# Staging/production values live in Vercel, EAS and GitHub Actions secrets.
# ---------------------------------------------------------------------------

PICKSEL_ENV=local

# --- Supabase: portal (Next.js) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Portal server actions / route handlers only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: field (Expo) ------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase project refs (CLI: link / push / gen types) ------------------
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PRODUCTION=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
