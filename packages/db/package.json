{
  "name": "@picksel/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "diff": "supabase db diff -f",
    "types": "supabase gen types typescript --local --schema public > src/types.generated.ts",
    "types:staging": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF_STAGING\" --schema public > src/types.generated.ts",
    "typecheck": "tsc --noEmit",
    "test:rls": "vitest run"
  },
  "devDependencies": {
    "@picksel/core": "workspace:*",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
